# =============================================================================
# im-account-service — example environment configuration
#
# Precedence: CLI flag > environment variable > config file > built-in default.
# Copy to .env and adjust. For OpenTelemetry variables see .env.otel.example.
# =============================================================================

# --- Service -----------------------------------------------------------------
# gRPC listen address (default: localhost:8080)
SERVICE_ADDR=localhost:8080

# Host advertised to service discovery. Optional; overrides the auto-detected
# host when set (e.g. when running behind a proxy/NAT).
# PROXY_GRPC_HOST=

# --- Outbound gRPC mTLS -------------------------------------------------------
# Verify TLS certificates on outbound gRPC connections. When true, the CA,
# cert and key paths below are required.
SERVICE_CONN_VERIFY_CERTS=false
# SERVICE_CONN_CA=
# SERVICE_CONN_CERT=
# SERVICE_CONN_KEY=
# SERVICE_CONN_CLIENT_CA=
# SERVICE_CONN_CLIENT_CERT=
# SERVICE_CONN_CLIENT_KEY=

# --- Logging ------------------------------------------------------------------
# Level: debug, info, warn, error (default: info)
LOG_LEVEL=info
# Emit logs as JSON (default: false)
LOG_JSON=false
# Write logs to stdout (default: true)
LOG_CONSOLE=true
# Write logs to this file path (default: none)
LOG_FILE=
# Bridge logs to OpenTelemetry (default: false). See .env.otel.example.
LOG_OTEL=false
# Per-module debug logging: comma-separated module names, or on/all to enable
# everything (e.g. WBTL_LOG_DEBUG=broker,store). Independent of LOG_LEVEL.
# WBTL_LOG_DEBUG=

# --- PostgreSQL ---------------------------------------------------------------
# DSN (required)
POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/webitel?sslmode=disable&connect_timeout=10
# Connection-pool tuning (0 = driver default / no limit)
# POSTGRES_MAX_OPEN_CONNS=0
# POSTGRES_MAX_IDLE_CONNS=0
# POSTGRES_CONN_MAX_IDLE_TIME=0
# POSTGRES_CONN_MAX_LIFETIME=0

# --- Redis --------------------------------------------------------------------
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# --- Consul (service discovery) -----------------------------------------------
CONSUL_ADDR=localhost:8500

# --- Pub/Sub (message broker) -------------------------------------------------
# Broker URL (required). Must start with amqp:// or amqps://.
PUBSUB_URL=amqp://admin:admin@localhost:5672?heartbeat=10
# Driver: amqp | rabbitmq (default: rabbitmq)
PUBSUB_DRIVER=amqp

# --- Profiler (pprof) ---------------------------------------------------------
# Listen address; empty disables the profiler.
# PROFILER_ADDR=
# PROFILER_MUTEX_FRACTION=1
# PROFILER_BLOCK_RATE=1