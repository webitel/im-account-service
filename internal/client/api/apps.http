# debug
# @name createApp
GRPC /webitel.im.service.admin.v1.Applications/CreateApp

{
  "app": {
    "dc": "1",
    "name": "My First App",
    "about": "Development purpose",
    "clients": {
      "ua": [
        "grpcurl/*",
        "Mozilla/*"
      ],
      "iDp": {
        "https://example.com/people": "example",
        "https://dev.webitel.com/portal": "portal",
        "https://example.org/oauth/clients": "example"
      },
      "jwt": {
        "enabled": true,
        "jwks": "",
        "jwks_uri": "http://127.0.0.1:9365/.well-known/jwks.json",
        "claims": {
          "sub": "iid|none|uid",
          "name": "my_var|var1",
          "scope": "",
          "audience": "aud"
        }
      },
      "net": {
        "cidr": [
          "127.0.0.1/32",
          "10.10.10.0/24",
          "172.17.0.0/16"
        ]
      },
      "web": {
        "origin": [
          "http://localhost:8080"
        ]
      }
    },
    "service": {
      "secret": "",
      "send_update": {
        "grpc": {
          "host": "172.17.0.1:26125"
        },
        "events": [
          "*"
        ]
      },
      "push_service": {
        "fcm": {
          "proxy": "http://172.17.0.1:26124/push/fcm"
        },
        "web": {
          "proxy": "http://172.17.0.1:26124/push/web"
        }
      }
    },
    "contacts": {
      "list": [
        {
          "type": "example"
        },
        {
          "user_id": "bot_account_id_that_should_be_visible_for_this_app"
        }
      ]
    }
  }
}